# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
.env
*.log
.secret_key

# Flask / GIS outputs (large + user data — never push)
uploads/
outputs/
CF_OUTPUT/
dem_catalog/
*.shp
*.shx
*.dbf
*.prj
*.cpg
# Shapefile sidecars — spatial indexes + XML metadata. Optional caches
# geopandas/fiona do not need, so they follow the rest of the family out.
*.sbn
*.sbx
*.shp.xml
*.tif
*.tiff
*.zip
*.kmz
*.png

# The brand logo is shipped as a PNG on purpose: the mark is one asset used
# by the header, the login page and the map overlay, so it cannot drift the
# way three hand-copied SVGs did. It has to be tracked or the site deploys
# without a logo.
!static/elfak-logo.png
!static/elfak-logo-64.png

# Thesis Map base bundle — required on Render for GET /thesis_options.
# Pre-dissolved 7 provinces + 77 districts (small, fast: Render only
# reprojects to the user's UTM zone). local_unit.shp stays as offline
# fallback/regeneration source.
!data/nepal/provinces.shp
!data/nepal/provinces.shx
!data/nepal/provinces.dbf
!data/nepal/provinces.prj
!data/nepal/districts.shp
!data/nepal/districts.shx
!data/nepal/districts.dbf
!data/nepal/districts.prj
!data/nepal/local_unit.shp
!data/nepal/local_unit.shx
!data/nepal/local_unit.dbf
!data/nepal/local_unit.prj

# DEM library seed (small Palpa tile so the catalog works on Render;
# users with other areas upload their own .tif). NOTE: files inside an
# excluded dir need the dir re-included first — order matters here.
!dem_catalog/
!dem_catalog/44N/
!dem_catalog/44N/PALPA_44N.tif
!dem_catalog/45N/
!dem_catalog/45N/.gitkeep

# Auth store contains token hashes — never push
users.json

